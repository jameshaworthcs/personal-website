{
  "name": "personal-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "images": "node scripts/images.mjs",
    "serve:out": "node scripts/serve-out.mjs",
    "test:e2e": "playwright test",
    "validate:html": "html-validate \"out/**/*.html\"",
    "screenshots": "node scripts/screenshots.mjs",
    "check:cv": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-cv.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.52.0",
    "next": "^16.3.8",
    "next-themes": "^0.4.6",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.8",
    "eslint-config-prettier": "^10.0.1",
    "html-validate": "^11.16.4",
    "postcss": "^8.5.10",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.0",
    "typescript": "^6"
  },
  "overrides": {
    "sucrase": "^3.35.1",
    "postcss": "^8.5.10"
  }
}
