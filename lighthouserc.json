{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve-out.mjs 4174",
      "startServerReadyPattern": "Serving out/",
      "url": [
        "http://localhost:4174/",
        "http://localhost:4174/cv",
        "http://localhost:4174/work/verified-handles",
        "http://localhost:4174/york-wines",
        "http://localhost:4174/privacy",
        "http://localhost:4174/work/verified-handles-mcp"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.05
          }
        ],
        "largest-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 2500
          }
        ],
        "total-byte-weight": [
          "error",
          {
            "maxNumericValue": 450000
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
